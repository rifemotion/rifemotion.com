[Unit]
Description=RifeMotion FastAPI Application
After=network.target

[Service]
User=root
WorkingDirectory=/var/www/rifemotion
ExecStart=/var/www/rifemotion/venv/bin/uvicorn app.main:app --host 127.0.0.1 --port 8000 --workers 2
Restart=always
RestartSec=3
EnvironmentFile=/var/www/rifemotion/.env

[Install]
WantedBy=multi-user.target
